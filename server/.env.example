# Phidias — API académica del colegio
PHIDIAS_BASE_URL=https://ds-barranquilla.phidias.co/rest
PHIDIAS_TOKEN=pegar_el_jwt_aqui

# Microsoft Entra ID (SSO institucional)
# El Redirect URI debe estar registrado en Azure como tipo "Web".
ENTRA_TENANT_ID=d065e67d-8e26-4632-a114-1caaf9422f02
ENTRA_CLIENT_ID=36564d1e-5d8b-448d-a5e6-b4421b383b7c
ENTRA_CLIENT_SECRET=pegar_el_secreto_de_azure
# En produccion: https://biblioteca.colegioaleman.edu.co/api/auth/microsoft/callback
# Para probar en local hay que registrar TAMBIEN esta URL en Azure.
ENTRA_REDIRECT_URI=http://localhost:4001/api/auth/microsoft/callback
SSO_ALLOWED_DOMAINS=colegioaleman.edu.co
FRONTEND_URL=http://localhost:3000
