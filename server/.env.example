PORT=4001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambiar
DB_NAME=biblioteca

# JWT — cambiar por un secreto largo y aleatorio en producción
JWT_SECRET=cambiar_este_secreto_en_produccion

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=cambiar
AWS_SECRET_ACCESS_KEY=cambiar
